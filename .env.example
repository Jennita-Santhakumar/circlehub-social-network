# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*

# Postgres
POSTGRES_DB=socialpulse
POSTGRES_USER=socialpulse
POSTGRES_PASSWORD=socialpulse
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery / Channels
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5230
CORS_ALLOW_ALL_ORIGINS=false

# Email (console backend by default; switch to SMTP for real delivery)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@socialpulse.local

# Rate limiting
THROTTLE_RATE_USER=120/minute
THROTTLE_RATE_ANON=20/minute

# Frontend
VITE_API_BASE_URL=http://localhost:8050
VITE_WS_BASE_URL=ws://localhost:8050
